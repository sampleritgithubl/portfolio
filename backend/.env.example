# Backend Environment Variables
# Copy this file to .env and fill in your credentials

PORT=5000

# Gmail credentials (use App Password if 2FA is enabled)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_TO=your-gmail@gmail.com

# Google Gemini AI (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Admin Login Password
ADMIN_PASSWORD="kavindu@#123"

# MongoDB Atlas (Free cloud database - prevents data disappearing on Render restarts)
# Get a 100% free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Cloudinary (Free permanent cloud image hosting CDN)
# Get a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively you can paste full CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://...

