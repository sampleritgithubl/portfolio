# EmailJS Configuration (Real-World Contact Form)
# Get these credentials by signing up for free at https://www.emailjs.com/

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Backend API URL (for production, set to your Render backend URL, e.g. https://kavindu-portfolio-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:5000
